	partition DimLaboratorio = m
		mode: import
		source =
				
				let
				    // A ÚNICA dimensão realmente compartilhada entre os dois domínios.
				    //              LCP   LCE   (LDP deixou de ser monitorado na v18)
				    //   Equipamentos 26     8     —
				    //   Calibração  119    57    32
				    // ⚠ AJUSTAR: os nomes por extenso abaixo são marcadores.
				    Origem = #table(
				        type table [ Laboratorio = text, #"Nome do Laboratório" = text, Ordem = Int64.Type ],
				        {
				            { "LCP", "LCP — ajustar nome oficial", 1 },
				            { "LCE", "LCE — ajustar nome oficial", 2 },
				            { "N/A", "Não informado",              9 }
				        }
				    )
				in
				    Origem

	annotation PBI_ResultType = Table
