table tbl_Pontos
	lineageTag: cd705c8f-f683-5e95-b32a-7ff967976590

	column Chave
		dataType: string
		lineageTag: 75acaf0a-a08e-5079-b562-d54272926597
		summarizeBy: none
		sourceColumn: Chave

		annotation SummarizationSetBy = Automatic

	column Ordem
		dataType: int64
		formatString: 0
		lineageTag: dab24940-6f2f-5307-9bb8-17ad20c58928
		summarizeBy: none
		sourceColumn: Ordem

		annotation SummarizationSetBy = Automatic

	column Tema
		dataType: string
		lineageTag: afae04dd-3ec6-532c-a07a-228262f77a74
		summarizeBy: none
		sourceColumn: Tema

		annotation SummarizationSetBy = Automatic

	partition tbl_Pontos = m
		mode: import
		source =
				let
				    // Linhas fixas da lista "Pontos que pedem decisão" (Visão Geral).
				    // Cada linha só aparece quando a medida [Ponto Ativo] = 1.
				    Origem = #table(
				        type table [ Chave = text, Ordem = Int64.Type, Tema = text ],
				        {
				            { "CAL", 1, "Calibração" }, { "AF1", 2, "Aferição · 1º ensaio" }, { "AF2", 3, "Aferição · 2º ensaio" },
				            { "INS", 4, "Inspeções" }, { "PAR", 5, "Paradas" }, { "DISP", 6, "Disponibilidade" }
				        }
				    )
				in
				    Origem

	annotation PBI_ResultType = Table
