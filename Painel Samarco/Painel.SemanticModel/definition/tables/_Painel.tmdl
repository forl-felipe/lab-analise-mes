	measure 'Inspeções · Fatos' =
			
			VAR _pl = COALESCE ( IF (
			    ISCROSSFILTERED ( DimCalendario ),
			    CALCULATE ( [Inspecoes Realizadas], KEEPFILTERS ( tbl_Inspecoes[Origem] = "Planilha" ) ),
			    CALCULATE ( CALCULATE ( [Inspecoes Realizadas], KEEPFILTERS ( tbl_Inspecoes[Origem] = "Planilha" ) ), KEEPFILTERS ( DimCalendario[Mês Atual] = TRUE () ) )
			), 0 )
			VAR _fo = COALESCE ( IF (
			    ISCROSSFILTERED ( DimCalendario ),
			    CALCULATE ( [Inspecoes Realizadas], KEEPFILTERS ( tbl_Inspecoes[Origem] = "Forms" ) ),
			    CALCULATE ( CALCULATE ( [Inspecoes Realizadas], KEEPFILTERS ( tbl_Inspecoes[Origem] = "Forms" ) ), KEEPFILTERS ( DimCalendario[Mês Atual] = TRUE () ) )
			), 0 )
			VAR _nc = COALESCE ( IF (
			    ISCROSSFILTERED ( DimCalendario ),
			    CALCULATE ( [Inspecoes Realizadas], KEEPFILTERS ( tbl_Inspecoes[Resultado_Inspecao] = "Nao Conforme" ) ),
			    CALCULATE ( CALCULATE ( [Inspecoes Realizadas], KEEPFILTERS ( tbl_Inspecoes[Resultado_Inspecao] = "Nao Conforme" ) ), KEEPFILTERS ( DimCalendario[Mês Atual] = TRUE () ) )
			), 0 )
			RETURN
			    _pl & " pela planilha + " & _fo & " pelo Forms  ·  " & _nc & IF ( _nc = 1, " não conforme", " não conformes" )
		displayFolder: 14 Inspeções (gerencial)
