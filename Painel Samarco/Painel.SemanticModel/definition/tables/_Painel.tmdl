	measure 'Linha no Período' =
			
			IF ( NOT ISBLANK ( IF (
			    ISCROSSFILTERED ( DimCalendario ),
			    COUNTROWS ( tbl_Afericoes ),
			    CALCULATE ( COUNTROWS ( tbl_Afericoes ), KEEPFILTERS ( DimCalendario[Mês Atual] = TRUE () ) )
			) ), 1 )
		formatString: 0
		isHidden
		displayFolder: 13 Aferições
