	measure 'Carta · Lim. Inferior' =
			
			VAR _ok =
			    CALCULATE ( DISTINCTCOUNT ( tbl_Afericoes[Equipamento] ), ALLSELECTED ( tbl_Afericoes[Data] ) ) = 1
			        && CALCULATE ( DISTINCTCOUNT ( tbl_Afericoes[Parâmetro] ), ALLSELECTED ( tbl_Afericoes[Data] ) ) = 1
			VAR _temLimite = NOT ISBLANK ( CALCULATE ( MAX ( tbl_Afericoes[Lim. Inferior] ), ALLSELECTED ( tbl_Afericoes[Data] ) ) )
			VAR _li = IF (
			    ISCROSSFILTERED ( DimCalendario ),
			    IF ( _temLimite, MIN ( tbl_Afericoes[Lim. Inferior] ), - MIN ( tbl_Afericoes[Tolerância] ) ),
			    CALCULATE ( IF ( _temLimite, MIN ( tbl_Afericoes[Lim. Inferior] ), - MIN ( tbl_Afericoes[Tolerância] ) ), KEEPFILTERS ( DimCalendario[Mês Atual] = TRUE () ) )
			)
			RETURN
			    IF ( _ok && NOT ISBLANK ( [Carta · Valor] ), _li )
		formatString: #,0.00
