	measure 'Equipamentos com NC' =
			
			IF (
			    ISCROSSFILTERED ( DimCalendario ),
			    CALCULATE ( DISTINCTCOUNT ( tbl_Afericoes[Equipamento] ), KEEPFILTERS ( tbl_Afericoes[Resultado] = "Não conforme" ) ),
			    CALCULATE ( CALCULATE ( DISTINCTCOUNT ( tbl_Afericoes[Equipamento] ), KEEPFILTERS ( tbl_Afericoes[Resultado] = "Não conforme" ) ), KEEPFILTERS ( DimCalendario[Mês Atual] = TRUE () ) )
			) + 0
		formatString: #,0
		displayFolder: 13 Aferições
		lineageTag: a435b9af-02c2-5a64-88c2-c6dc450bdd99

	measure Reincidentes =
			
			COUNTROWS ( FILTER ( VALUES ( tbl_Afericoes[Equipamento] ), [NC Aferição] >= 2 ) ) + 0
		formatString: #,0
		displayFolder: 13 Aferições
		lineageTag: 52bfa350-6879-5b0b-a6eb-45c92c99285a

	measure 'Reincidentes · Lista' =
			
			VAR _t = FILTER ( ADDCOLUMNS ( VALUES ( tbl_Afericoes[Equipamento] ), "@nc", [NC Aferição] ), [@nc] >= 2 )
			RETURN
			    IF (
			        COUNTROWS ( _t ) > 0,
			        CONCATENATEX ( TOPN ( 4, _t, [@nc], DESC, tbl_Afericoes[Equipamento], ASC ), tbl_Afericoes[Equipamento] & " (" & [@nc] & "×)", " · ", [@nc], DESC ),
			        "nenhum equipamento reincidente"
			    )
		displayFolder: 13 Aferições
		lineageTag: f21d296c-1866-5f08-be79-6a4f6482f4ca

	measure 'Aferições Programadas' =
			
			VAR _sel = ISFILTERED ( DimCalendario[Ano Mês Nome] )
			VAR _ini = IF ( _sel, CALCULATE ( MIN ( DimCalendario[Data] ), ALLSELECTED ( DimCalendario ) ), DATE ( YEAR ( TODAY () ), MONTH ( TODAY () ), 1 ) )
			VAR _fimMes = IF ( _sel, CALCULATE ( MAX ( DimCalendario[Data] ), ALLSELECTED ( DimCalendario ) ), EOMONTH ( TODAY (), 0 ) )
			VAR _fim = MIN ( _fimMes, TODAY () - 1 )
			RETURN
			    SUMX (
			        FILTER ( DimEnsaio, DimEnsaio[Tem Rotina] ),
			        VAR _dias = DimEnsaio[Dias Semana]
			        VAR _por = DimEnsaio[Por Dia]
			        VAR _sem = DimEnsaio[Semanal]
			        RETURN
			        IF (
			                _fim < _ini, 0,
			                IF (
			                    _sem,
			                    CALCULATE ( DISTINCTCOUNT ( DimCalendario[Semana Início] ), ALL ( DimCalendario ), DimCalendario[Data] >= _ini, DimCalendario[Data] <= _fim ),
			                    _por
			                        * CALCULATE (
			                            COUNTROWS ( DimCalendario ),
			                            ALL ( DimCalendario ),
			                            DimCalendario[Data] >= _ini,
			                            DimCalendario[Data] <= _fim,
			                            CONTAINSSTRING ( _dias, FORMAT ( DimCalendario[Dia Semana Número], "0" ) )
			                        )
			                )
			            )
			    )
		formatString: #,0
		displayFolder: 13 Aferições
		lineageTag: 4f9a378f-da64-5a51-a54e-85035ffa368c

	measure 'Aferições Realizadas' =
			
			VAR _sel = ISFILTERED ( DimCalendario[Ano Mês Nome] )
			VAR _ini = IF ( _sel, CALCULATE ( MIN ( DimCalendario[Data] ), ALLSELECTED ( DimCalendario ) ), DATE ( YEAR ( TODAY () ), MONTH ( TODAY () ), 1 ) )
			VAR _fimMes = IF ( _sel, CALCULATE ( MAX ( DimCalendario[Data] ), ALLSELECTED ( DimCalendario ) ), EOMONTH ( TODAY (), 0 ) )
			VAR _fim = MIN ( _fimMes, TODAY () - 1 )
			RETURN
			    SUMX (
			        FILTER ( DimEnsaio, DimEnsaio[Tem Rotina] ),
			        VAR _dias = DimEnsaio[Dias Semana]
			        VAR _por = DimEnsaio[Por Dia]
			        VAR _sem = DimEnsaio[Semanal]
			        VAR _prog = IF (
			                _fim < _ini, 0,
			                IF (
			                    _sem,
			                    CALCULATE ( DISTINCTCOUNT ( DimCalendario[Semana Início] ), ALL ( DimCalendario ), DimCalendario[Data] >= _ini, DimCalendario[Data] <= _fim ),
			                    _por
			                        * CALCULATE (
			                            COUNTROWS ( DimCalendario ),
			                            ALL ( DimCalendario ),
			                            DimCalendario[Data] >= _ini,
			                            DimCalendario[Data] <= _fim,
			                            CONTAINSSTRING ( _dias, FORMAT ( DimCalendario[Dia Semana Número], "0" ) )
			                        )
			                )
			            )
			        VAR _feitas =
			            IF (
			                _por = 2,
			                CALCULATE ( COUNTROWS ( tbl_Afericoes ), ALL ( DimCalendario ), tbl_Afericoes[Parâmetro] = "Blaine Manual", tbl_Afericoes[Data] >= _ini, tbl_Afericoes[Data] <= _fim ),
			                IF (
			                    _sem,
			                    CALCULATE ( DISTINCTCOUNT ( tbl_Afericoes[Semana Início] ), ALL ( DimCalendario ), tbl_Afericoes[Data] >= _ini, tbl_Afericoes[Data] <= _fim ),
			                    CALCULATE ( DISTINCTCOUNT ( tbl_Afericoes[Data] ), ALL ( DimCalendario ), tbl_Afericoes[Data] >= _ini, tbl_Afericoes[Data] <= _fim )
			                )
			            )
			        RETURN
			            MIN ( COALESCE ( _feitas, 0 ), _prog )
			    )
		formatString: #,0
		displayFolder: 13 Aferições
		lineageTag: 4b387642-3763-5c59-8108-fa5ef1f734a9

	measure 'Aderência à Rotina' =
			
			IF ( ISEMPTY ( ALL ( tbl_Afericoes ) ), BLANK (), DIVIDE ( [Aferições Realizadas], [Aferições Programadas] ) )
		formatString: 0%
		displayFolder: 13 Aferições
		lineageTag: e26ce801-87fc-508d-8b37-3a85e24dda15

	measure 'Ensaio Aparece' =
			
			IF ( NOT ISEMPTY ( ALL ( tbl_Afericoes ) ) && ( NOT ISBLANK ( [Aferições Avaliadas] ) || [Aferições Programadas] > 0 ), 1, 0 )
		formatString: 0
		isHidden
		displayFolder: 13 Aferições
		lineageTag: dccbd637-a8d0-5a97-99e6-4f87f4fcd99c

	measure 'Nível Aferições' =
			
			VAR _v = [% Aferições Conformes]
			VAR _m = [Meta Aferições Conformes]
			RETURN
			    IF ( ISBLANK ( _v ), BLANK (), IF ( _v >= _m, 1, IF ( _v >= _m - 0.05, 2, 3 ) ) )
		formatString: 0
		isHidden
		displayFolder: 13 Aferições
