	measure 'Disponibilidade no Mês' =
			
			CALCULATE ( [% Disponibilidade], KEEPFILTERS ( DimCalendario[Mês Atual] = TRUE () ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 11 Disponibilidade e paradas
		lineageTag: c9c9f74f-36f7-587f-954d-aca7abe87115

	measure 'Horas Paradas no Mês' =
			
			CALCULATE ( [Horas Paradas], KEEPFILTERS ( DimCalendario[Mês Atual] = TRUE () ) )
		formatString: #,0.0
		displayFolder: 11 Disponibilidade e paradas
		lineageTag: 1b81ccc2-cdc3-5e80-8a2b-cb5fb483adfd

	measure 'Horas Paradas (mês)' =
			
			COALESCE ( [Horas Paradas no Mês], 0 )
		formatString: #,0.0
		displayFolder: 11 Disponibilidade e paradas
		lineageTag: 9db6b865-031a-5e7b-b22d-a6653ba7c53d

	measure 'Paradas no Mês' =
			
			COALESCE ( CALCULATE ( COUNTROWS ( Tbl_Paradas ), KEEPFILTERS ( DimCalendario[Mês Atual] = TRUE () ) ), 0 )
		formatString: #,0
		displayFolder: 11 Disponibilidade e paradas
		lineageTag: 9dcbf345-b7b0-5f02-a859-ccf7e552535e

	measure 'Paradas em Aberto' =
			
			COALESCE (
			    CALCULATE (
			        COUNTROWS ( Tbl_Paradas ),
			        KEEPFILTERS ( NOT ( Tbl_Paradas[Situação] IN { "Resolvido", "Resolvida", "Concluído", "Concluída" } ) ),
			        KEEPFILTERS ( NOT ISBLANK ( Tbl_Paradas[Situação] ) )
			    ),
			    0
			)
		formatString: #,0
		displayFolder: 11 Disponibilidade e paradas
		lineageTag: 385ecab8-c949-56e5-a133-c2013b96679d

	measure 'Disponibilidade Semana' =
			
			VAR _dias = CALCULATE ( COUNTROWS ( DimCalendario ), KEEPFILTERS ( DimCalendario[Data Passada] = TRUE () ) )
			VAR _cap = [Total Equipamentos] * _dias * 24
			RETURN
			    IF ( _cap > 0, DIVIDE ( _cap - [Horas Paradas], _cap ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 11 Disponibilidade e paradas
		lineageTag: c395b331-7086-5ce4-a9fd-9cd828047307

	measure 'Nível Disponibilidade' =
			
			VAR _v = [Disponibilidade no Mês]
			VAR _m = [Param Meta Disponibilidade]
			VAR _r = DIVIDE ( _v, _m )
			RETURN
			    IF ( ISBLANK ( _v ) || ISBLANK ( _m ), BLANK (), IF ( _r >= 1, 1, IF ( _r >= 0.9, 2, 3 ) ) )
		formatString: 0
		isHidden
		displayFolder: 11 Disponibilidade e paradas
		lineageTag: ba4235f8-757c-5349-b3cd-96d1a914ad4a

	measure 'Situação Disponibilidade' =
			
			SWITCH ( [Nível Disponibilidade], 1, "● Na meta", 2, "▲ Atenção", 3, "◆ Crítico", "○ Sem dados" )
		displayFolder: 11 Disponibilidade e paradas
		lineageTag: 6df79153-d2cb-5e16-bece-6578a34df389

	measure 'Cor Disponibilidade' =
			
			SWITCH ( [Nível Disponibilidade], 1, "#1B6FB0", 2, "#C99400", 3, "#E0620F", "#8C98A2" )
		isHidden
		displayFolder: 11 Disponibilidade e paradas
		lineageTag: 3f170088-c249-5e75-bfa7-c31ec897923f

	measure 'Disponibilidade · Meta' =
			
			VAR _n = [Nível Disponibilidade]
			RETURN
			    "meta " & FORMAT ( [Param Meta Disponibilidade], "0%" ) & " · "
			        & SWITCH ( _n, 1, "na meta", 2, "um pouco abaixo da meta", 3, "abaixo da meta", "sem dados no mês" )
		displayFolder: 11 Disponibilidade e paradas
		lineageTag: 15a83911-684e-57d4-9fa8-2e2eba5f6641

	measure 'Disponibilidade · Fatos' =
			
			VAR _a = [Paradas em Aberto]
			RETURN
			    FORMAT ( [Horas Paradas (mês)], "#,0.0" ) & " h paradas no mês  ·  " & _a
			        & IF ( _a = 1, " parada em aberto", " paradas em aberto" )
		displayFolder: 11 Disponibilidade e paradas
		lineageTag: 59d06d3e-96f0-5eb4-9b30-a3c2ef18e998

	measure 'Barra Disponibilidade' =
			
			MIN ( COALESCE ( [Disponibilidade no Mês], 0 ), 1 )
		formatString: 0%
		isHidden
		displayFolder: 11 Disponibilidade e paradas
		lineageTag: 273e553f-693a-5428-a69b-50334d3000a3

	measure 'Barra Disponibilidade Resto' =
			
			1 - [Barra Disponibilidade]
		formatString: 0%
		isHidden
		displayFolder: 11 Disponibilidade e paradas
		lineageTag: 546e5687-6475-5e2c-9c30-d3c8d3649cb5

	measure 'Cor Barra Disponibilidade Grupo' =
			
			VAR _m = COALESCE ( MAX ( tbl_Grupos[Meta Disponibilidade] ), [Param Meta Disponibilidade] )
			VAR _v = [Disponibilidade no Mês]
			RETURN
			    IF ( ISBLANK ( _v ), "#8C98A2", IF ( _v >= _m, "#1B6FB0", IF ( _v >= _m * 0.9, "#C99400", "#E0620F" ) ) )
		isHidden
		displayFolder: 11 Disponibilidade e paradas
		lineageTag: 11e80690-3bab-54d2-a027-f16b3e009451

	measure 'Cor Horas Paradas' =
			
			IF ( [Paradas em Aberto] > 0, "#E0620F", "#1B6FB0" )
		isHidden
		displayFolder: 11 Disponibilidade e paradas
		lineageTag: 8f81ac67-7e4a-5146-bcca-f83ad75dd70b

	measure 'Última Parada' =
			
			VAR _d = CALCULATE ( MAX ( Tbl_Paradas[Data] ) )
			RETURN
			    IF (
			        NOT ISBLANK ( _d ),
			        FORMAT ( _d, "dd/MM" ) & " · " & CALCULATE ( MAX ( Tbl_Paradas[Ocorrência] ), Tbl_Paradas[Data] = _d )
			    )
		displayFolder: 11 Disponibilidade e paradas
		lineageTag: 42535c25-9814-54d7-ac05-a8ef4b16c2ea

	measure 'Situação da Última Parada' =
			
