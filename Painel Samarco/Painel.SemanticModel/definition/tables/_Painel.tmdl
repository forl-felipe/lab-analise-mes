			        [@nc] > 0
			            && CALCULATE (
			                COUNTROWS ( tbl_Calibracao ),
			                FILTER ( ALL ( tbl_Calibracao[TagKey] ), SUBSTITUTE ( tbl_Calibracao[TagKey], "-", "" ) = tbl_Afericoes[TagKey] ),
			                KEEPFILTERS ( tbl_Calibracao[StatusAtual] = "Vencido" )
			            ) > 0
			    ),
