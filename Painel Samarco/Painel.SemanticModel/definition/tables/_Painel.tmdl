	measure 'Carta · Valor' =
			
			VAR _ok =
			    CALCULATE ( DISTINCTCOUNT ( tbl_Afericoes[Equipamento] ), ALLSELECTED ( tbl_Afericoes[Data] ) ) = 1
			        && CALCULATE ( DISTINCTCOUNT ( tbl_Afericoes[Parâmetro] ), ALLSELECTED ( tbl_Afericoes[Data] ) ) = 1
			VAR _temLimite = NOT ISBLANK ( CALCULATE ( MAX ( tbl_Afericoes[Lim. Inferior] ), ALLSELECTED ( tbl_Afericoes[Data] ) ) )
			VAR _v = IF (
			    ISCROSSFILTERED ( DimCalendario ),
			    IF ( _temLimite, AVERAGE ( tbl_Afericoes[Valor] ), AVERAGE ( tbl_Afericoes[Diferença] ) ),
			    CALCULATE ( IF ( _temLimite, AVERAGE ( tbl_Afericoes[Valor] ), AVERAGE ( tbl_Afericoes[Diferença] ) ), KEEPFILTERS ( DimCalendario[Mês Atual] = TRUE () ) )
			)
			RETURN
			    IF ( _ok, _v )
		formatString: #,0.00
		displayFolder: 13 Aferições
