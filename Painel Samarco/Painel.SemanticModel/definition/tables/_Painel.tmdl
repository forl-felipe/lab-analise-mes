table _Painel
	lineageTag: 94f90df7-6199-5c78-9c33-e0536b278ddc

	measure 'Mês de Referência' =
			
			VAR _d = IF ( ISFILTERED ( DimCalendario[Ano Mês Nome] ), MAX ( DimCalendario[Data] ), TODAY () )
			VAR _t = FORMAT ( _d, "MMMM yyyy", "pt-BR" )
			RETURN
			    UPPER ( LEFT ( _t, 1 ) ) & MID ( _t, 2, 100 )
		displayFolder: 10 Período e metas
		lineageTag: c8967b12-8d2c-571a-a0a5-d307ce625fdf

	measure 'Meta Calibração em Dia' =
			
			VAR _v = LOOKUPVALUE ( tbl_Config[Valor], tbl_Config[Parâmetro], "Meta Calibração em Dia (%)" )
			RETURN
			    IF ( ISBLANK ( _v ) || _v = "", 0.9, DIVIDE ( VALUE ( _v ), 100 ) )
		formatString: 0%
		displayFolder: 10 Período e metas
		lineageTag: 70d38547-6cd4-598a-bc2a-7444db868df6

	measure 'Meta Aferições Conformes' =
			
			VAR _v = LOOKUPVALUE ( tbl_Config[Valor], tbl_Config[Parâmetro], "Meta Aferições Conformes (%)" )
			RETURN
			    IF ( ISBLANK ( _v ) || _v = "", 0.95, DIVIDE ( VALUE ( _v ), 100 ) )
		formatString: 0%
		displayFolder: 10 Período e metas
		lineageTag: 43134554-de7e-5769-a62e-e508f5dbf238

	measure 'Meta Aderência à Rotina' =
			
			VAR _v = LOOKUPVALUE ( tbl_Config[Valor], tbl_Config[Parâmetro], "Meta Aderência Rotina (%)" )
			RETURN
