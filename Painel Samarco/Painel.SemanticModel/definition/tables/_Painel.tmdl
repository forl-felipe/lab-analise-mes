			RETURN
			    IF (
			        ISBLANK ( _pc ) && ISBLANK ( _ad ), BLANK (),
			        IF (
			            NOT ISBLANK ( _pc ) && _pc < _m - 0.05, 3,
			            IF ( ( NOT ISBLANK ( _pc ) && _pc < _m ) || ( NOT ISBLANK ( _ad ) && _ad < _ma ), 2, 1 )
