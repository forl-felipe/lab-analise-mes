			VAR _r = DIVIDE ( _v, _m )
			RETURN
			    IF ( ISBLANK ( _v ) || ISBLANK ( _m ), BLANK (), IF ( _r >= 1, 1, IF ( _r >= 0.9, 2, 3 ) ) )
