			    CALCULATE ( IF ( _temLimite, MAX ( tbl_Afericoes[Lim. Superior] ), MAX ( tbl_Afericoes[Tolerância] ) ), KEEPFILTERS ( DimCalendario[Mês Atual] = TRUE () ) )
			)
