  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#0B2540" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#0B2540" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#5D6B7D" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#0B2540" }
