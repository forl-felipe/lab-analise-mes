  "good": "#1E7F4F",
  "neutral": "#B54708",
  "bad": "#B42318",
  "maximum": "#0E6BA8",
  "center": "#E1EEF8",
  "minimum": "#FFFFFF",
  "background": "#FFFFFF",
  "foreground": "#172334",
