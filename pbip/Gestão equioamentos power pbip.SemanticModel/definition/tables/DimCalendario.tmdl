	partition DimCalendario = calculated
		mode: import
		source =
				
				VAR _Hoje = TODAY ()
				VAR _Base = SELECTCOLUMNS ( CALENDAR ( DATE ( 2024, 1, 1 ), DATE ( 2030, 12, 31 ) ), "Data", [Date] )
				RETURN
				ADDCOLUMNS (
				    _Base,
				    "Ano",               YEAR ( [Data] ),
				    "Trimestre",         "T" & FORMAT ( [Data], "Q" ),
				    "Ano Trimestre",     YEAR ( [Data] ) & "-T" & FORMAT ( [Data], "Q" ),
				    "Mês Número",        MONTH ( [Data] ),
				    "Mês",               FORMAT ( [Data], "MMM", "pt-BR" ),
				    "Mês Completo",      FORMAT ( [Data], "MMMM", "pt-BR" ),
				    "Ano Mês",           FORMAT ( [Data], "yyyy-MM" ),
				    "Ano Mês Nome",      FORMAT ( [Data], "MMM/yy", "pt-BR" ),
				    "Dia",               DAY ( [Data] ),
				    "Dia Semana Número", WEEKDAY ( [Data], 2 ),
				    "Dia Semana",        FORMAT ( [Data], "ddd", "pt-BR" ),
				    "Semana ISO",        WEEKNUM ( [Data], 21 ),
				    "Ano Semana",        YEAR ( [Data] ) & "-S" & FORMAT ( WEEKNUM ( [Data], 21 ), "00" ),
				    "Tipo de Dia",       IF ( WEEKDAY ( [Data], 2 ) > 5, "Fim de semana", "Dia útil" ),
				    "Ano Offset",        YEAR ( [Data] ) - YEAR ( _Hoje ),
				    "Mês Offset",        ( YEAR ( [Data] ) - YEAR ( _Hoje ) ) * 12 + MONTH ( [Data] ) - MONTH ( _Hoje ),
				    "Data Passada",      [Data] <= _Hoje,
				    "Mês Atual",         EOMONTH ( [Data], 0 ) = EOMONTH ( _Hoje, 0 )
				)

	annotation PBI_ResultType = Table
